---
import Icon from "./Icon.astro";

// How it works: SHOP-29 from a note to main, as drawn (Landing3.dc.html's LANES and BEATS). The page loads on the
// first beat; the player script (piece 5's flow.ts and player.ts) moves it on through the data- attributes.
const lanes = [
  { title: "Ready for Dev", color: "var(--st-queued)" },
  { title: "Dev", color: "var(--st-working)" },
  { title: "Security", color: "var(--st-investigate)" },
  { title: "Review", color: "var(--st-review)" },
  { title: "Done", color: "var(--st-queued)" },
];
const steps = ["Filed", "Started", "Asks you", "Failed → fixed", "Review", "Merged"];
const laneLeft = (i: number): string =>
  `calc(10px + (100% - 20px - 32px) / 5 * ${String(i)} + 8px * ${String(i)})`;
---

<section class="sec" id="how">
  <div class="wrap">
    <div class="rv">
      <div class="label">How it works</div>
      <h2 class="h2">Say what you want. Answer when asked. Approve the diff.</h2>
      <p class="sub">
        Everything in between is agents, checked by other agents. Watch SHOP-29 go from a note to main.
      </p>
    </div>
    <div class="flow rv" data-flow>
      <div class="stage-scroll">
        <div class="stage">
          <div class="lanes">
            {lanes.map((ln, i) => (
              <div class:list={["lane", { on: i === 0 }]} data-lane>
                <div class="lane-h">
                  <span class="k" style={`background: ${ln.color}`} />
                  {ln.title}
                </div>
              </div>
            ))}
          </div>
          <div class="tk" style={`left: ${laneLeft(0)}`} data-card>
            <div class="top">
              SHOP-29<span style="flex:1"></span>
              <span class="av av-CC" data-card-av>
                CC
              </span>
            </div>
            <div class="ti">Coupon field at checkout</div>
            <span class="pill p-q" data-card-pill>
              <Icon icon="activity" />
              <span data-text>Ready for Dev</span>
            </span>
            <div class="meta" data-card-meta>
              filed by Noyan · P2
            </div>
          </div>
          <div class="tk ghost" style={`left: ${laneLeft(0)}`} data-ghost>
            <div class="top">
              SHOP-20<span style="flex:1"></span>
              <span class="av av-CC">CC</span>
            </div>
            <div class="ti">Checkout page</div>
            <span class="pill p-q" data-ghost-pill>
              <Icon icon="hourglass" />
              <span data-text>waits for SHOP-29</span>
            </span>
          </div>
        </div>
      </div>
      <div class="flow-f">
        <div class="now">
          <span class="n" data-now-n>
            1 of 6
          </span>
          <h3 data-now-title>Noyan, your planning agent, files it</h3>
          <p data-now-text>
            You said “add a coupon field at checkout”. Noyan read the code and filed SHOP-29 with what it
            found. It starts in priority order, once an agent is free.
          </p>
        </div>
        <div>
          <div class="steps" style="--d: 4200ms">
            {steps.map((label, i) => (
              <button
                class:list={["stp", { on: i === 0 }]}
                type="button"
                aria-current={i === 0 ? "step" : "false"}
                data-step={i}
              >
                {label}
                <span class="bar a" />
              </button>
            ))}
          </div>
          <div class="ctl">
            <button class="btn btn-s btn-sm" type="button" data-play>
              <Icon icon="pause" class="s13" />
              <span data-text>Pause</span>
            </button>
            <span>You step in twice. Click a step to jump to it.</span>
          </div>
        </div>
        <div class="sources">
          <b>Tickets come from wherever you work:</b>
          <span>
            <Icon icon="bot" class="s13" />
            <span>
              Ask Noyan: “Why is checkout slow? Make tickets.” It reads the code and proposes them; you say
              go.
            </span>
          </span>
          <span>
            <Icon icon="git-branch" class="s13" />
            <span>
              Import from your tracker: Noyan runs your own import skill on GitHub issues, Jira or Linear.
            </span>
          </span>
          <span>
            <Icon icon="keyboard" class="s13" />
            <span>
              Write one yourself: <span class="kbd">⌘N</span>, or <span class="mono">otaq create</span> from a
              terminal or script.
            </span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

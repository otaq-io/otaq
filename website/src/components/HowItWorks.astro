---
import Icon from "./Icon.astro";
import { BEAT_MS, LANES, STEP_LABELS, beatView } from "./flow";

// How it works: SHOP-29 from a note to main, as drawn (Landing3.dc.html's LANES and BEATS). The page loads on the
// first beat; player.ts moves it on through the data- attributes.
const v = beatView(0);
---

<section class="sec" id="how">
  <div class="wrap">
    <div class="rv">
      <div class="label">How it works</div>
      <h2 class="h2">Say what you want. Answer when asked. Approve the diff.</h2>
      <p class="sub">
        Everything in between is agents, checked by other agents. Watch SHOP-29 go from a note to main.
      </p>
    </div>
    <div class="flow rv" data-flow>
      <div class="stage-scroll">
        <div class="stage">
          <div class="lanes">
            {LANES.map((ln, i) => (
              <div class:list={["lane", { on: v.lanesOn[i] }]} data-lane>
                <div class="lane-h">
                  <span class="k" style={`background: ${ln.color}`} />
                  {ln.title}
                </div>
              </div>
            ))}
          </div>
          <div class:list={["tk", { attn: v.card.attn }]} style={`left: ${v.card.left}`} data-card>
            <div class="top">
              SHOP-29<span style="flex:1"></span>
              <span class={`av av-${v.card.tool}`} data-card-av>
                {v.card.tool}
              </span>
            </div>
            <div class="ti">Coupon field at checkout</div>
            <span class={`pill ${v.card.pillClass}`} data-card-pill>
              <Icon icon={v.card.icon} class={v.card.spin ? "spin" : undefined} />
              <span data-text>{v.card.label}</span>
            </span>
            <div class="meta" data-card-meta>
              {v.card.meta}
            </div>
          </div>
          <div class="tk ghost" style={`left: ${v.ghost.left}`} data-ghost>
            <div class="top">
              SHOP-20<span style="flex:1"></span>
              <span class="av av-CC">CC</span>
            </div>
            <div class="ti">Checkout page</div>
            <span class={`pill ${v.ghost.pillClass}`} data-ghost-pill>
              <Icon icon={v.ghost.icon} class={v.ghost.spin ? "spin" : undefined} />
              <span data-text>{v.ghost.label}</span>
            </span>
          </div>
        </div>
      </div>
      <div class="flow-f">
        <div class="now">
          <span class="n" data-now-n>
            {v.n}
          </span>
          <h3 data-now-title>{v.title}</h3>
          <p data-now-text>{v.text}</p>
        </div>
        <div>
          <div class="steps" style={`--d: ${String(BEAT_MS)}ms`}>
            {STEP_LABELS.map((label, i) => (
              <button
                class:list={["stp", { on: i === 0 }]}
                type="button"
                aria-current={i === 0 ? "step" : "false"}
                data-step={i}
              >
                {label}
                <span class="bar a" />
              </button>
            ))}
          </div>
          <div class="ctl">
            <button class="btn btn-s btn-sm" type="button" data-play>
              <Icon icon="pause" class="s13" />
              <span data-text>Pause</span>
            </button>
            <span>You step in twice. Click a step to jump to it.</span>
          </div>
        </div>
        <div class="sources">
          <b>Tickets come from wherever you work:</b>
          <span>
            <Icon icon="bot" class="s13" />
            <span>
              Ask Noyan: “Why is checkout slow? Make tickets.” It reads the code and proposes them; you say
              go.
            </span>
          </span>
          <span>
            <Icon icon="git-branch" class="s13" />
            <span>
              Import from your tracker: Noyan runs your own import skill on GitHub issues, Jira or Linear.
            </span>
          </span>
          <span>
            <Icon icon="keyboard" class="s13" />
            <span>
              Write one yourself: <span class="kbd">⌘N</span>, or <span class="mono">otaq create</span> from a
              terminal or script.
            </span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { startPlayer } from "./player";

  startPlayer();
</script>

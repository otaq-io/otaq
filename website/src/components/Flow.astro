---
import Icon from "./Icon.astro";
import { KIND_COLOR, PRESETS, isLong } from "./presets";

// Design your flow, as drawn. Every preset's track is in the HTML, "Your own" shown and the rest hidden, so the page
// reads right without a script; the preset picker script (piece 5) flips them through data-preset / data-track.
const first = PRESETS[0]?.id;
const kinds = [
  {
    color: "var(--st-working)",
    title: "An agent does the work",
    text: "Runs a skill you pick, in the ticket’s own worktree. Asks you when the ticket doesn’t say.",
  },
  {
    color: "var(--st-investigate)",
    title: "An agent checks it",
    text: "Passes or fails the work, in rounds. Each check has one agent; two checks run one after the other.",
  },
  {
    color: "var(--st-review)",
    title: "You check it",
    text: "You read the change and approve it, or send it back with what to fix.",
  },
];
const why = [
  {
    color: "var(--st-working)",
    stage: "Dev",
    text: ["Your sessions run ", "pnpm test", " before every commit, in 112 of 130 sessions."],
  },
  {
    color: "var(--st-investigate)",
    stage: "Security",
    text: ["From 41 ", "/security-review", " runs in shop-web."],
  },
  {
    color: "var(--st-investigate)",
    stage: "Validate",
    text: ["You ask for a second look before merging in most sessions that touch ", "prisma/", "."],
  },
  { color: "var(--st-review)", stage: "Review · you", text: ["Every merge in the last 60 days was yours."] },
  {
    color: "var(--st-approved)",
    stage: "Done · PR",
    text: ["Your remote is GitHub and ", "gh", " is signed in."],
  },
];
// Edit flow, on the board: each column header is its stage, Backlog and Done fixed at the ends, + between two
// columns adds a stage; Security is picked and shows its details.
const cols = [
  { color: "var(--st-queued)", name: "Backlog", what: "Every flow starts here", fixed: true },
  {
    color: "var(--st-working)",
    name: "Dev",
    what: "An agent does the work",
    who: "Rust developer",
    skill: "work-ticket",
  },
  {
    color: "var(--st-investigate)",
    name: "Security",
    what: "An agent checks it",
    who: "Security reviewer",
    skill: "security-check",
    sel: true,
  },
  {
    color: "var(--st-investigate)",
    name: "Validate",
    what: "An agent checks it",
    who: "Checker",
    skill: "validate",
    tint: true,
  },
  { color: "var(--st-review)", name: "Review", what: "You check it", who: "You" },
  { color: "var(--st-approved)", name: "Done", what: "Pull request · on Approve", fixed: true },
];
---

<section class="sec" id="flow">
  <div class="wrap">
    <div class="rv">
      <div class="label">Design your flow</div>
      <h2 class="h2">Build the flow your tickets walk.</h2>
      <p class="sub">
        Your board’s columns are your process. You decide the stages, in your order, and what each one is: an
        agent working, an agent checking, or you checking. If a check fails, the work goes back to the stage
        you choose, and Done says how work leaves: a merge or a pull request, on your Approve or by itself.{" "}
        <b>Start from a preset, or have one made from how you already work.</b> Flip them to see the columns
        change.
      </p>
    </div>
    <div class="fd rv" data-presets>
      <div class="fd-top">
        <span class="lbl">Start from</span>
        {PRESETS.map((p) => (
          <button
            class:list={["pre", { on: p.id === first }]}
            type="button"
            aria-pressed={p.id === first ? "true" : "false"}
            data-preset={p.id}
          >
            <b>{p.name}</b>
            <span>{p.desc}</span>
          </button>
        ))}
        <span class="cnt" style="margin-left:auto">
          Presets use your default model.
        </span>
      </div>
      <div class="fd-stage">
        {PRESETS.map((p) => (
          <div class:list={["track", { long: isLong(p) }]} data-track={p.id} hidden={p.id !== first}>
            {p.stages.map((s, i) => (
              <div
                class:list={["stg", { you: s.kind === "you", add: s.add }]}
                style={`animation-delay: ${String(i * 60)}ms`}
              >
                <div class="box">
                  <div class="nm">
                    <span class="k" style={`background: ${KIND_COLOR[s.kind]}`} />
                    {s.name}
                  </div>
                  {s.who && <div class="who">{s.who}</div>}
                  {s.fail && (
                    <div class="fail">
                      fails return to <b>{s.fail}</b>
                    </div>
                  )}
                  {s.note && <div class="fail">{s.note}</div>}
                </div>
                {i < p.stages.length - 1 && <Icon icon="chevron-right" class="arrow" />}
              </div>
            ))}
          </div>
        ))}
      </div>
      <div class="fd-kinds-h">Every stage you add is one of three kinds</div>
      <div class="fd-f">
        {kinds.map((k) => (
          <div class="kind">
            <div class="h">
              <span class="k" style={`background:${k.color}`} />
              {k.title}
            </div>
            <p>{k.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="why rv">
      <div>
        <h3 style="margin:0 0 8px;font-size:24px;letter-spacing:-.5px;font-weight:600">
          Or have one made from how you already work.
        </h3>
        <p class="sub" style="font-size:15.5px">
          In Edit flow, <b>Start from… → Suggest a flow</b> asks Noyan’s agent, in Claude Code, Codex, Copilot
          or OpenCode, to read its own history and your repo. It drafts a flow on the board, every change
          marked with why. Save it, ask for changes, or discard it.
        </p>
      </div>
      <div class="why-card">
        <div class="why-h">
          <span class="av md av-CC">CC</span>
          <b>Rust developer’s suggestion for shop-web</b>
          <span style="color: var(--text-muted)">· Claude Code</span>
        </div>
        {why.map((r) => (
          <div class="why-r">
            <span class="s">
              <span class="k" style={`background:${r.color}`} />
              {r.stage}
            </span>
            <span class="w">{r.text.map((t, i) => (i % 2 === 1 ? <span class="mono">{t}</span> : t))}</span>
          </div>
        ))}
        <div class="why-f">
          <Icon icon="info" class="s13" />
          Nothing runs, and no tokens are spent, until you ask.
        </div>
      </div>
    </div>

    <div class="ed rv" role="group" aria-label="Edit flow, on the board">
      <div class="ed-bar">
        <Icon icon="columns" class="s13" />
        <div class="ed-t">
          <b>Editing shop-web’s flow</b>
          <span>Drag to reorder · click a stage for details · + to add</span>
        </div>
        <span class="sp"></span>
        <span class="it">
          <Icon icon="play" class="s12" />
          Watch a ticket
        </span>
        <span class="it">Start from…</span>
        <span class="btn btn-g btn-sm">Cancel</span>
        <span class="btn btn-p btn-sm">Save flow</span>
      </div>
      <div class="ed-cols">
        {cols.map((c, i) => (
          <Fragment>
            {i > 0 && (
              <span class="ed-add" aria-hidden="true">
                +
              </span>
            )}
            <div class:list={["ed-col", { sel: c.sel, tint: c.tint, fixed: c.fixed }]}>
              <div class="nm">
                <span class="k" style={`background:${c.color}`} />
                {c.name}
              </div>
              <div class="wh">{c.what}</div>
              {c.who && <div class="who">{c.who}</div>}
              {c.skill && <div class="mono sk">{c.skill}</div>}
            </div>
          </Fragment>
        ))}
      </div>
      <div class="det">
        <b>Name</b>
        <span>Security</span>
        <b>What happens</b>
        <span>An agent checks it</span>
        <b>What it’s for</b>
        <span>Looks for unescaped SQL, secrets and auth changes, so none of them reaches your review.</span>
        <b>Agent</b>
        <span>Security reviewer · Claude Code</span>
        <b>Skill</b>
        <span class="mono">security-check</span>
        <b>Fails go to</b>
        <span>Dev · 3 rounds</span>
      </div>
      <div class="apply">
        <span>
          Noyan’s agent moved Validate after Security, marked with why. Reordering waits until no ticket is in
          the stages it touches; nothing changes until you save.
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  // The preset picker: one track shown, the others hidden. A track that is un-hidden plays the drawn pop-in again,
  // since its stages' `pop` animation restarts when they go from display: none to shown.
  const picker = document.querySelector<HTMLElement>("[data-presets]");
  const buttons = [...(picker?.querySelectorAll<HTMLButtonElement>("[data-preset]") ?? [])];
  const tracks = [...(picker?.querySelectorAll<HTMLElement>("[data-track]") ?? [])];

  function pick(id: string): void {
    buttons.forEach((b) => {
      const on = b.dataset["preset"] === id;
      b.classList.toggle("on", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    tracks.forEach((t) => {
      t.hidden = t.dataset["track"] !== id;
    });
  }

  buttons.forEach((b) => {
    b.addEventListener("click", () => {
      const id = b.dataset["preset"];
      if (id !== undefined) pick(id);
    });
  });
</script>

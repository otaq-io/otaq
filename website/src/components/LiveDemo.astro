---
import Icon from "./Icon.astro";

// The live demo's section, as drawn: the headings, the things to try, and the frame the demo (piece 4) fills.
const tries = [
  { icon: "hand", text: "Press Next on the strip" },
  { icon: "columns", text: "Change flow…" },
  { icon: "bot", text: "Ask Noyan" },
  { icon: "eye", text: "Approve SHOP-18" },
  { icon: "pause", text: "Pause" },
];
---

<section class="sec" id="demo">
  <div class="wrap">
    <div class="demo-head rv">
      <div>
        <div class="label">Live demo</div>
        <h2 class="h2">Try it right here.</h2>
        <p class="sub">
          shop-web, with a flow of its own. Click around: nothing really runs, and nothing leaves this page.
        </p>
      </div>
      <div class="tries" role="group" aria-label="Things to try">
        {tries.map((t) => (
          <span class="try">
            <Icon icon={t.icon} />
            {t.text}
          </span>
        ))}
      </div>
    </div>
    <div class="demo-frame" data-demo-frame>
      <div class="demo-clip" data-demo-clip></div>
    </div>
    <div class="viewonly" data-demo-note hidden>
      <Icon icon="monitor" />
      This is a view-only preview. Open the page on a computer to click around the demo.
    </div>
  </div>
</section>

<script>
  import { demoFrame } from "./demoScale";

  // Scale the 1280 × 800 board to the page width, on load and on every resize (WEB-05).
  const frame = document.querySelector<HTMLElement>("[data-demo-frame]");
  const clip = document.querySelector<HTMLElement>("[data-demo-clip]");
  const note = document.querySelector<HTMLElement>("[data-demo-note]");

  function fit(): void {
    if (!frame || !clip || !note) return;
    const f = demoFrame(document.documentElement.clientWidth || window.innerWidth || 1440);
    frame.style.width = `${String(f.width)}px`;
    frame.style.height = `${String(f.height)}px`;
    clip.style.transform = `scale(${f.scale.toFixed(4)})`;
    clip.style.pointerEvents = f.viewOnly ? "none" : "auto";
    note.style.width = `${String(f.width)}px`;
    note.hidden = !f.viewOnly;
  }

  fit();
  window.addEventListener("resize", fit);
</script>

---
import Icon from "./Icon.astro";
import { REPO_URL } from "./links";
import Mark from "./Mark.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="nav">
  <div class="wrap nav-in">
    <a class="brand" href="#top" aria-label="Otaq home">
      <Mark size={26} />
      Otaq
    </a>
    <nav class="nav-links" aria-label="Sections">
      <a href="#how">How it works</a>
      <a href="#flow">Your flow</a>
      <a href="#demo">Demo</a>
      <a href="#faq">FAQ</a>
    </nav>
    <ThemeToggle />
    <a class="btn btn-s btn-sm gh" href={REPO_URL}>
      <Icon icon="git-branch" />
      GitHub
    </a>
    <a class="btn btn-p btn-sm" href="#install">
      Build from source
    </a>
  </div>
</header>

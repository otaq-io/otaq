---
import Icon from "./Icon.astro";

// The dim board moving behind the headline: six lanes and seven travelling cards, as drawn. Its words come from
// `data-label` through CSS (landing.css), not as text: they are decoration, deliberately dim, and as text they would
// fail the contrast check (WEB-06). Under reduced motion the cards are hidden and nothing floats.
const lanes = ["Backlog", "Dev", "Security", "Review", "Ship", "Done"];
const cards = [
  { top: 150, delay: -4, key: "SHOP-14" },
  { top: 230, delay: -12, key: "SHOP-29", bar: 60, kind: "back" },
  { top: 310, delay: -30, key: "SHOP-22", bar: 70, kind: "n" },
  { top: 400, delay: -20, key: "SHOP-35", bar: 55 },
  { top: 480, delay: -44, key: "SHOP-12", kind: "n" },
  { top: 560, delay: -36, key: "SHOP-19", bar: 65 },
  { top: 190, delay: -50, key: "SHOP-31", bar: 50 },
];
---

<section class="hero">
  <div class="bgb" aria-hidden="true">
    <div class="lanes">
      {lanes.map((t) => (
        <div class="lane">
          <span data-label={t} />
        </div>
      ))}
    </div>
    <div class="trk">
      {cards.map((c) => (
        <div class:list={["bc", c.kind]} style={`top:${String(c.top)}px;animation-delay:${String(c.delay)}s`}>
          <div class="bci">
            <i data-label={c.key} />
            <b style={c.bar === undefined ? undefined : `width:${String(c.bar)}%`} />
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="fl attn" style="left:3%;top:130px;--r:-2deg" aria-hidden="true">
    <span class="pulse"></span>
    <div class="top">
      SHOP-22<span style="flex:1"></span>
      <span class="av av-CC">CC</span>
    </div>
    <div class="ti">Fix flaky login redirect</div>
    <span class="pill p-a">
      <Icon icon="hand" />
      Needs you
    </span>
    <div class="top" style="color: var(--st-attn)">
      allow rm -rf .next?
    </div>
  </div>
  <div class="fl f2" style="right:3%;top:160px;--r:2deg" aria-hidden="true">
    <div class="top">
      SHOP-29<span style="flex:1"></span>
      <span class="av av-CC">CC</span>
    </div>
    <div class="ti">Coupon field</div>
    <span class="pill p-pa">
      <Icon icon="undo" />
      Security failed · back to Dev
    </span>
    <div class="top">round 2 · unescaped SQL</div>
  </div>
  <div class="fl f3" style="left:5%;top:430px;--r:1.5deg" aria-hidden="true">
    <div class="top">
      <Icon icon="bot" class="s12" style="color: var(--st-investigate)" />
      Noyan, your planning agent
    </div>
    <div class="ti">Filed 3 tickets from “why is checkout slow?”</div>
    <span class="pill p-i">
      <Icon icon="check" />
      In Backlog
    </span>
  </div>
  <div class="fl f4" style="right:5%;top:440px;--r:-1.5deg" aria-hidden="true">
    <div class="top">
      SHOP-40<span style="flex:1"></span>
      <span class="av av-CC">CC</span>
    </div>
    <div class="ti">Wishlist</div>
    <span class="pill p-w">
      <Icon icon="loader" class="spin" />3 helpers · 1 asks you
    </span>
    <div class="top">40.1 merged · 40.2 asks · 40.3 working</div>
  </div>

  <div class="wrap hero-in">
    <p class="pain">
      Three agents means three terminals to watch, three “done”s to trust, and three diffs you didn’t read.
    </p>
    <h1 class="hl">
      Coding agents that follow <em>your</em> process.
    </h1>
    <p class="lede">
      A desktop app that runs Claude Code, Codex, GitHub Copilot and OpenCode through stages you design.
    </p>
    <div class="cta">
      <a class="btn btn-p btn-lg" href="#install">
        Build from source
        <Icon icon="arrow-right" />
      </a>
      <a class="btn btn-s btn-lg" href="#demo">
        Try the live demo
      </a>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="trust rv">
    <span>
      <Icon icon="monitor" />
      Runs on your machine
    </span>
    <span>
      <Icon icon="plug" />
      Your own subscriptions
    </span>
    <span>
      <Icon icon="lock" />
      Merges only the way your flow says
    </span>
    <span>
      <Icon icon="server" />
      No account, no server
    </span>
    <span>
      <Icon icon="git-branch" />
      Source available · FSL-1.1-MIT
    </span>
  </div>
</div>

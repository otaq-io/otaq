---
import "../styles/fonts.css";
import "../styles/tokens.css";

// Every page's <head>: the title in the v3 hero's words (Landing3.dc.html), a description short enough for a search
// result (~155 characters), the canonical address, the link-preview card, and the app icon as favicon.
const title = "Otaq — Coding agents that follow your process";
const description =
  "A desktop app that runs Claude Code, Codex, GitHub Copilot and OpenCode through stages you design. Runs on your machine, with your own subscriptions.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL("/og.png", Astro.site).href;
const imageAlt = "Otaq: Coding agents that follow your process.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // The visitor's theme pick (theme.ts: "otaq-theme", "dark" | "light"), applied before paint so a reload never
      // flashes the other theme. No pick, or storage blocked: the page follows the system setting (WEB-11).
      try {
        var pick = window.localStorage.getItem("otaq-theme");
        if (pick === "dark" || pick === "light") document.documentElement.dataset.theme = pick;
      } catch {
        // Storage blocked: follow the system.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Otaq" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    background: var(--bg-app);
  }
  body {
    margin: 0;
  }
</style>

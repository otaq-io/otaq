---
import "../styles/landing.css";
import Agents from "../components/Agents.astro";
import BigWork from "../components/BigWork.astro";
import Faq from "../components/Faq.astro";
import Flow from "../components/Flow.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Icons from "../components/Icons.astro";
import Install from "../components/Install.astro";
import LiveDemo from "../components/LiveDemo.astro";
import NeedsYou from "../components/NeedsYou.astro";
import Nav from "../components/Nav.astro";
import Review from "../components/Review.astro";
import Base from "../layouts/Base.astro";

// The landing page, as drawn on the canvas (Landing3.dc.html, "v3 · shorter, benefits first"), section by section
// (WEB-04).
---

<Base>
  <div class="lp">
    <Icons />
    <Nav />
    <main id="top">
      <Hero />
      <HowItWorks />
      <Flow />
      <NeedsYou />
      <Review />
      <LiveDemo />
      <BigWork />
      <Agents />
      <Install />
      <Faq />
    </main>
  </div>
</Base>

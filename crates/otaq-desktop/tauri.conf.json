{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otaq",
  "identifier": "io.otaq.desktop",
  "version": "0.1.0",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/otaq-io/otaq/releases/latest/download/latest.json"],
      "pubkey": "PLACEHOLDER — replaced by the maintainer before the first release (T-0583)"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Run your coding agents from one board",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "bundle/windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"],
        "preRemoveScript": "bundle/linux/prerm"
      }
    }
  }
}
